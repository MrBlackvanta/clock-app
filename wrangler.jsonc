{
  "name": "clock-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "PLACE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 10 },
    },
  ],
}
